    console.log(`Tienes ${calculoAnosUsuario} años. Podras conducir en ${legalAge - calculoAnosUsuario}`);
}

//14. Escriba un script que solicite por prompt al usuario que ingrese el número de años. Calcular el número de segundos que puede vivir una persona. Supongamos que alguien vive solo cien años 
const now = new Date();
const anoActual = now.getFullYear();
console.log('Año Actual:' + anoActual);
const secondsInYear = 365 * 24 * 60 * 60;

let anosUsuarioPrompt = prompt("Ingrese sus años");
let calculoNaciUsuario = anoActual - anosUsuarioPrompt
console.log('Año Nacimiento Usuario:' + calculoNaciUsuario);
console.log('Años Usuario:' + anosUsuarioPrompt)

let secondsPassed = anosUsuarioPrompt * secondsInYear;
console.log(`Segundos que puede vivir a la edad de ${anosUsuarioPrompt}:` + secondsPassed);

//15. Cree un formato de hora legible por humanos usando el objeto Date.

const now = new Date();
const year = now.getFullYear(); // return años
const month = now.getMonth() + 1; // return meses(0 - 11)
const date = now.getDate(); // return días (1 - 31)
const hours = now.getHours(); // return horas (0 - 23)
const minutes = now.getMinutes(); // return minutos (0 -59)

//YYYY-MM-DD HH:mm
console.log(`${year}-${month}-${date} ${hours}:${minutes}`);
//DD-MM-YYYY HH:mm
console.log(`${date}-${month}-${year} ${hours}:${minutes}`);
//DD/MM/YYYY HH:mm
console.log(`${date}/${month}/${year} ${hours}:${minutes}`);
