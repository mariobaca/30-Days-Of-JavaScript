//1. The following is an array of 10 students ages:
const ages = [19, 22, 19, 24, 20, 25, 26, 24, 25, 24]

// Sort the array and find the min and max age
console.log(ages.sort())
console.log(Math.min(...ages));
console.log(Math.max(...ages));


// Find the median age(one middle item or two middle items divided by two)
const sortedAges = ages.sort((a, b) => a - b);
console.log(sortedAges)
const half = Math.floor(sortedAges.length / 2);
console.log(ages[half])

// Find the average age(all items divided by number of items)
console.log(ages)
let agesLength = ages.length;
console.log(agesLength)
let average = (ages[0] + ages[1] + ages[2] + ages[3] + ages[4] + ages[5] + ages[6] + ages[7] + ages[8] + ages[9]) / agesLength;
console.log(average)

// Find the range of the ages(max minus min)
let agesMin = Math.min(...ages)
let agesmax = Math.max(...ages)
console.log(agesMin)
console.log(agesmax)
let range = agesmax - agesMin
console.log(range)


// Compare the value of (min - average) and (max - average), use abs() method 1.
Math.abs(agesMin - average) < Math.abs(agesmax - average) ? console.log("Data is left skewed") : console.log('Data is right skewed!');

