//14. Filter out companies which have more than one 'o' without the filter method
    // 1. Juntamos todo en un texto: "Facebook,Google,Microsoft,Apple,IBM,Oracle,Amazon"
    const texto = itCompanies.join(',');
    // 2. Esta RegEx busca palabras que tengan más de una 'o' (ignorando mayúsculas/minúsculas)
    // y las reemplaza por un espacio vacío.
    const textoLimpio = texto.replace(/\b\w*o\w*o\w*\b,?/gi, '');
    // 3. Limpiamos comas sueltas al final y volvemos a separar por comas
    const filteredCompanies = textoLimpio.replace(/,$/, '').split(',');
    console.log(filteredCompanies);
    // Resultado: ['Apple', 'IBM', 'Oracle', 'Amazon']


